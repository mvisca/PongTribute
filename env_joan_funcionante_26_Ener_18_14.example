# ==================================================
# GLOBAL
# ==================================================
NODE_ENV=development
LOG_LEVEL=fatal


# ==================================================
# AUTH SERVICE
# ==================================================
AUTH_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_PORT=3002
AUTH_SERVICE_HOST=localhost
JWT_SECRET=create_your_super_secret_key_here
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=10
UNIQUE_SESSION=true

# ==================================================
# GAME SERVICE
# ==================================================
GAME_SERVICE_URL=http://localhost:3003
GAME_SERVICE_PORT=3003
GAME_SERVICE_HOST=localhost
GAME_SERVICE_DB_FILENAME=game.db
GAME_SERVICE_DB_PATH=./packages/game

# ==================================================
# USER SERVICE
# ==================================================
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_PORT=3001
USER_SERVICE_HOST=localhost
USER_SERVICE_DB_FILENAME=user.db
USER_SERVICE_DB_PATH=.

# ==================================================
# IMAGE SERVICE
# ==================================================
IMAGE_SERVICE_URL=http://localhost:3004
IMAGE_SERVICE_PORT=3004
IMAGE_SERVICE_HOST=localhost
CLOUDINARY_CLOUD_NAME=dayvpa0ql
CLOUDINARY_API_KEY=381682522269978
CLOUDINARY_API_SECRET=eO-iLHeRLYN-H2JQrxEgkyaEtTg
CLOUDINARY_URL=cloudinary://381682522269978:eO-iLHeRLYN-H2JQrxEgkyaEtTg@dayvpa0ql
CLOUDINARY_DEFAULT_AVATAR=https://res.cloudinary.com/dayvpa0ql/image/upload/v1766352011/Default_Avatar_tmo0iu_c_fill_w_250_h_250_ar_1_1_r95cpw.png

# ==================================================
# FRONTEND
# ==================================================
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173
FRONTEND_HOST=localhost

# Gateway CORS: mismo origen que Nginx
CORS_ORIGIN=https://localhost


# ==================================================
# INTER-SERVICE COMMUNICATION
# ==================================================
SERVICE_SECRET=create_your_secure_shared_secret_between_services
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=create_a_supersafe_redis_password
REDIS_DB=0


# ==================================================
# SECURITY (JWT / tokens)
# ==================================================
JWT_SECRET=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD
TOKEN_EXPIRY=36000
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=10
UNIQUE_SESSION=true
