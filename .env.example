# ==================================================
# GLOBAL
# ==================================================
NODE_ENV=development
LOG_LEVEL=debug
UID=1000
GID=1000

# ==================================================
# AUTH SERVICE
# ==================================================
AUTH_SERVICE_URL=http://ft_transcendence_auth:3002
AUTH_SERVICE_PORT=3002
AUTH_SERVICE_HOST=0.0.0.0
JWT_SECRET=change_me_super_secret_jwt_key
COOKIE_SECRET=change_me_super_secret_cookie_key
RESET_URL_BASE=https://localhost:8443/recover
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=84600
PROVISIONAL_TOKEN_LIFETIME=60
BCRYPT_ROUNDS=10
UNIQUE_SESSION=true
RESET_TTL_SECONDS=900

# ==================================================
# USER SERVICE
# ==================================================
USER_SERVICE_URL=http://ft_transcendence_user:3001
USER_SERVICE_PORT=3001
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_DB_FILENAME=user.db
USER_SERVICE_DB_PATH=./packages/user/db

# ==================================================
# IMAGE SERVICE
# ==================================================
IMAGE_SERVICE_URL=http://ft_transcendence_images:3004
IMAGE_SERVICE_PORT=3004
IMAGE_SERVICE_HOST=0.0.0.0
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_api_key:your_cloudinary_api_secret@your_cloud_name
CLOUDINARY_DEFAULT_AVATAR=https://res.cloudinary.com/your_cloud_name/image/upload/default_avatar.png

# ==================================================
# GAME SERVICE
# ==================================================
GAME_SERVICE_URL=http://ft_transcendence_game:3003
GAME_SERVICE_PORT=3003
GAME_SERVICE_HOST=0.0.0.0
GAME_SERVICE_DB_FILENAME=game.db
GAME_SERVICE_DB_PATH=./packages/game/db

# ==================================================
# COMMS SERVICE
# ==================================================
COMMS_SERVICE_URL=http://ft_transcendence_comms:3005
COMMS_SERVICE_PORT=3005
COMMS_SERVICE_HOST=0.0.0.0
WS_PING_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=10000
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_USER=3

# ==================================================
# FRONTEND
# ==================================================
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173
FRONTEND_HOST=localhost
VITE_API_URL=https://localhost:8443/api
VITE_WS_COMMS_URL=wss://localhost:8443/ws/comms
VITE_WS_GAME_URL=wss://localhost:8443/ws/game
VITE_DEFAULT_AVATAR=https://res.cloudinary.com/your_cloud_name/image/upload/default_avatar.png

# ==================================================
# GATEWAY
# ==================================================
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
GATEWAY_TIMEOUT_MS=10000
GATEWAY_BODY_LIMIT=14680064
CORS_ORIGIN=http://localhost,https://localhost,https://localhost:8443
WS_ALLOWED_ORIGINS=https://localhost,https://localhost:8443
WS_MAX_CONNECTIONS_PER_IP=10
WS_UPSTREAM_OPEN_TIMEOUT_MS=5000
WS_MAX_BUFFERED_AMOUNT_BYTES=1048576
WS_MAX_BUFFERED_MESSAGES=100
DOCS_USER=admin
DOCS_PASS=change_me_docs_password

# ==================================================
# BOT SERVICE
# ==================================================
BOT_SERVICE_PORT=3007
BOT_SERVICE_HOST=0.0.0.0
GATEWAY_URL=http://gateway:3000

# ==================================================
# INTER-SERVICE COMMUNICATION
# ==================================================
SERVICE_SECRET=change_me_shared_service_secret
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# ==================================================
# MAILER
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your_email@example.com
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true