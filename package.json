{
	"name": "transcendence",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"packageManager": "pnpm@10.18.2",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": "10.18.2"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "pnpm build:contracts && tsc --build && pnpm --filter '@transcendence/frontend' build",
		"build:api": "pnpm build:contracts && pnpm --filter '!@transcendence/frontend' --filter '@transcendence/*' build",
		"build:contracts": "pnpm --filter @transcendence/shared build:schemas",
		"clean": "pnpm -r exec rm -rf dist && tsc --build --clean",
		"docker:up": "pnpm build:contracts && docker compose up -d",
		"docker:build": "pnpm build:contracts && docker compose up --build",
		"docker:down": "docker compose down",
		"docker:clean": "docker compose down -v",
		"docker:logs": "docker compose logs -f",
		"redis": "docker compose up -d redis",
		"redis:stop": "docker compose stop redis",
		"redis:logs": "docker compose logs -f redis",
		"redis:cli": "docker exec -it ft_transcendence_redis redis-cli",
		"redis:flush": "docker exec -it ft_transcendence_redis redis-cli FLUSHALL",
		"dev": "pnpm docker:up && sleep 2 && pnpm start:dev",
		"start:dev": "pnpm --parallel --filter '@transcendence/*' start:dev",
		"start:dev-gateway": "pnpm --filter '@transcendence/gateway' start:dev",
		"start:dev-user": "pnpm --filter '@transcendence/user' start:dev",
		"start:dev-auth": "pnpm --filter '@transcendence/auth' start:dev",
		"start:dev-game": "pnpm --filter '@transcendence/game' start:dev",
		"start:dev-comms": "pnpm --filter '@transcendence/comms' start:dev"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@types/node": "24.7.2",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"ioredis": "5.8.2"
	}
}
