{
	"name": "transcendence",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"packageManager": "pnpm@10.18.2",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": "10.18.2"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"redis": "docker compose up -d",
		"redis:stop": "docker compose down",
		"redis:clean": "docker compose down -v",
		"redis:logs": "docker compose logs -f redis",
		"redis:cli": "docker exec -it ft_transcendence_redis redis-cli",
		"redis:flush": "docker exec ft_transcendence_redis redis-cli FLUSHALL",
		"build": "tsc --build && pnpm --filter '@transcendence/frontend' build",
		"clean": "pnpm -r exec rm -rf dist && tsc --build --clean",
		"test": "pnpm -r --no-bail test",
		"test:user": "pnpm --filter '@transcendence/user' test:user",
		"test:user-api": "pnpm --filter '@transcendence/user' test:user-api",
		"test:user-other": "pnpm --filter '@transcendence/user' test:other",
		"test:friendship": "pnpm --filter '@transcendence/friendship' test:friendship",
		"test:auth": "pnpm --filter '@transcendence/auth' test:login",
		"test:auth-api": "pnpm --filter '@transcendence/auth' test:login-api",
		"test:auth-e2e": "pnpm --filter '@transcendence/auth' test:jwt-api",
		"dev": "pnpm redis && sleep 2 & pnpm start:dev",
		"start:dev": "pnpm --parallel --filter '@transcendence/*' start:dev",
		"start:dev-user": "pnpm --filter '@transcendence/user' start:dev",
		"start:dev-auth": "pnpm --filter '@transcendence/auth' start:dev",
		"start:dev-game": "pnpm --filter '@transcendence/game' start:dev",
		"test:game:public-matchmaking": "pnpm --filter @transcendence/game test:public-matchmaking",
    	"test:game:private-matchmaking": "pnpm --filter @transcendence/game test:private-matchmaking",
    	"test:game:ws": "pnpm --filter @transcendence/game test:ws",
    	"test:game:all": "pnpm --filter @transcendence/game test:all"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@types/ioredis": "5.0.0",
		"@types/node": "24.7.2",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"ioredis": "5.8.2"
	}
}