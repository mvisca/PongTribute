# ==================================================
# ft_transcendence - Docker environment (example)
# ==================================================
# Uso recomendado:
#   cp env.docker.example .env
#   # reemplaza los placeholders por valores reales (puedes copiarlos desde .env_old)
#   docker compose up --build -d
#
# Nota: este archivo NO debe contener secretos reales.
#

# ==================================================
# GLOBAL
# ==================================================
NODE_ENV=production
LOG_LEVEL=info

# ==================================================
# AUTH SERVICE
# ==================================================
AUTH_SERVICE_URL=http://auth:3002
AUTH_SERVICE_PORT=3002
AUTH_SERVICE_HOST=0.0.0.0

# ==================================================
# GAME SERVICE
# ==================================================
GAME_SERVICE_URL=http://game:3003
GAME_SERVICE_PORT=3003
GAME_SERVICE_HOST=0.0.0.0
GAME_SERVICE_DB_FILENAME=game.db
GAME_SERVICE_DB_PATH=.

# ==================================================
# USER SERVICE
# ==================================================
USER_SERVICE_URL=http://user:3001
USER_SERVICE_PORT=3001
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_DB_FILENAME=user.db
USER_SERVICE_DB_PATH=.

# ==================================================
# IMAGE SERVICE
# ==================================================
IMAGE_SERVICE_URL=http://images:3004
IMAGE_SERVICE_PORT=3004
IMAGE_SERVICE_HOST=0.0.0.0

# ==================================================
# FRONTEND (servido por Nginx)
# ==================================================
FRONTEND_URL=https://localhost
FRONTEND_PORT=443
FRONTEND_HOST=localhost

# Gateway CORS: mismo origen que Nginx
CORS_ORIGIN=https://localhost

# ==================================================
# INTER-SERVICE COMMUNICATION + REDIS
# ==================================================
SERVICE_SECRET=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD
REDIS_DB=0

# ==================================================
# SECURITY (JWT / tokens)
# ==================================================
JWT_SECRET=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD
TOKEN_EXPIRY=36000
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=10
UNIQUE_SESSION=true

# ==================================================
# CLOUDINARY (copiar valores reales desde .env_old)
# ==================================================
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD
CLOUDINARY_API_KEY=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD
CLOUDINARY_API_SECRET=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD

# IMPORTANTE: debe coincidir con:
# cloudinary://<CLOUDINARY_API_KEY>:<CLOUDINARY_API_SECRET>@<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_URL=cloudinary://REPLACE_ME:REPLACE_ME@REPLACE_ME

# URL pública real (https://res.cloudinary.com/...)
CLOUDINARY_DEFAULT_AVATAR=REPLACE_WITH_REAL_VALUE_FROM_ENV_OLD

