
{
	"compilerOptions": {
		// compilacion
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		
		// interoperabilidad
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		
		// type checking
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		
		// salida
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		
		// referencias de proyecto 
		"composite": true,
		
		// paths
		"baseUrl": ".",
		"paths": {
			"@transcendence/shared": ["../shared/dist/index.d.ts"],
			"@transcendence/shared/*": ["../shared/dist/*"]
		}
	},

	"include": ["src/**/*", "../shared/src/errors"],
	
	"exclude": [
		"node_modules",
		"dist"
	],
	
	"references": [
		{ "path": "../shared" }
	]
}