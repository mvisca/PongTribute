{
	"name": "@transcendence/user",
	"version": "1.1.0",
	"type": "module",
	"main": "./dist/src/server.js",
	"scripts": {
		"dev": "tsx src/server.ts",
		"build": "tsc",
		"start:dev": "tsx watch src/server.ts",
		"start": "node dist/src/server.js",
		"test:user": "tsx ./test/test-user-repository.ts",
		"test:user-api": "tsx ./test/test-user-api.ts",
		"test:friendship": "tsx ./test/test-friendship-repository.ts",
		"test:friendship:mapper": "tsx ./test/friendship.mapper.test.ts",
		"test:friendship:repo": "pnpm exec tsx --test ./test/friendship.repository.test.ts",
		"test:friendship:api": "pnpm exec tsx --test ./test/friendship.api.test.ts",
		"test:friendship:service": "pnpm exec tsx --test ./test/friendship.service.test.ts",
		"test:friendship:new": "pnpm exec tsx --test ./test/friendship.*.test.ts",
		"test:other": "tsx ./test/other-test.ts"
	},
	"dependencies": {
		"@fastify/helmet": "13.0.2",
		"@fastify/rate-limit": "10.3.0",
		"@sinclair/typebox": "0.34.41",
		"@transcendence/shared": "workspace:*",
		"bcryptjs": "3.0.3",
		"better-sqlite3": "12.4.1",
		"dotenv": "17.2.3",
		"fastify": "5.6.2",
		"jsonwebtoken": "9.0.2",
		"@fastify/swagger": "9.6.1",
		"pino-pretty": "13.1.2",
		"@fastify/swagger-ui": "5.2.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "3.0.0",
		"@types/better-sqlite3": "7.6.13",
		"@types/jsonwebtoken": "9.0.10",
		"@types/node": "24.7.2",
		"tsx": "4.20.6",
		"typescript": "5.9.3"
	}
}
