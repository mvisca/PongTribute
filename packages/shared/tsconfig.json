{
  "extends": "../../tsconfig.json",
  
  "compilerOptions": {
	
	"esModuleInterop": true,
	"allowSyntheticDefaultImports": true,
	// === COMPILACIÓN ==="
	"rootDir": ".",
	"outDir": "./dist",
	"composite": true,

    // === LIBRERÍA ===
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    
    // === SIN ENTORNO ESPECÍFICO ===
    "lib": ["ES2022"],
    "types": []
  },
  
  "include": [ "constants/**/*",
			   "events/**/*",
			   "schema/**/*",
			   "types/**/*",
			   "utils/**/*",
			   "index.ts"]
}