// packages/shared/tsconfig.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,  // ← No genera dist/, solo valida tipos
    "composite": true // ← Permite project references
  },
  "include": [
    "types/**/*",
    "events/**/*",
    "constants/**/*",
    "utils/**/*",
    "index.ts"
  ],
  "exclude": ["node_modules", "test-db.ts"]
}