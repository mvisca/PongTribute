{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"composite": true,
		"baseUrl": ".",
		"paths": {
			"@transcendence/shared": [
				"../shared/dist/index.d.ts"
			],
			"@transcendence/shared/*": [
				"../shared/dist/*"
			]
		}
	},
	"include": [
		"src/**/*"
		//"test/test-game.ts",
		//"test/test-db.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	],
	"references": [
		{
			"path": "../shared"
		}
	]
}