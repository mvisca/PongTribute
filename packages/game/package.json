  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.7.2",
    "@types/ws": "^8.5.10",
    "jsonwebtoken": "9.0.2",
