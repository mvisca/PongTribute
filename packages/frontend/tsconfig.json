{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"declaration": true,
		"composite": true,
		"noEmit": true,
		"outDir": "./dist"
	},
	"include": [".src/**/*"],
	"references": [
		{ "path": "../shared" }
	]
}