{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": [
		"connection.ts",
		"mappers/**/*.ts",
		"repositories/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.d.ts"
	]
}