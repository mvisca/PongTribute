{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"composite": true,
		"baseUrl": ".",
		"paths": {
			"@transcendence/shared": ["../shared/dist/index.d.ts"],
			"@transcendence/shared/*": ["../shared/dist/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist"
	],
	"references": [
		{ "path": "../shared" }
	]
}
