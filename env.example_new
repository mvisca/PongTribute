# ============================
# ft_transcendence (Docker)
# ============================
# Copia este archivo a .env:
#   cp env.example_new .env
#
# Nota:
# - En Docker, usa *_HOST=0.0.0.0 para que los servicios escuchen fuera del contenedor.
# - URLs internas deben apuntar por nombre de servicio (auth, user, game, gateway, images, redis).
#

# ----------------------------
# Global
# ----------------------------
NODE_ENV=production
LOG_LEVEL=info

# Secreto inter-servicios (header x-service-secret)
SERVICE_SECRET=CHANGE_ME_SERVICE_SECRET

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=365d
BCRYPT_ROUNDS=10
UNIQUE_SESSION=true

# ----------------------------
# Redis
# ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ----------------------------
# Services - Hosts/Ports
# ----------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000

USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=3001

AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=3002

GAME_SERVICE_HOST=0.0.0.0
GAME_SERVICE_PORT=3003

IMAGE_SERVICE_HOST=0.0.0.0
IMAGE_SERVICE_PORT=3004

# ----------------------------
# Services - Internal URLs (Docker DNS)
# ----------------------------
USER_SERVICE_URL=http://user:3001
AUTH_SERVICE_URL=http://auth:3002
GAME_SERVICE_URL=http://game:3003
IMAGE_SERVICE_URL=http://images:3004

# ----------------------------
# Frontend / CORS origin
# ----------------------------
# Cuando nginx sirva el frontend, esto debería ser el mismo origen https://<host>
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Gateway CORS: en prod idealmente será https://<host>
CORS_ORIGIN=https://localhost

# ----------------------------
# SQLite (persistencia)
# ----------------------------
USER_SERVICE_DB_PATH=.
USER_SERVICE_DB_FILENAME=user.db

GAME_SERVICE_DB_PATH=.
GAME_SERVICE_DB_FILENAME=game.db

# ----------------------------
# Cloudinary (Images/Auth/User)
# ----------------------------
# IMPORTANTE: debe coincidir con: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET
CLOUDINARY_URL=cloudinary://CHANGE_ME_CLOUDINARY_API_KEY:CHANGE_ME_CLOUDINARY_API_SECRET@CHANGE_ME_CLOUD_NAME

# URL pública de avatar por defecto (https://res.cloudinary.com/...)
CLOUDINARY_DEFAULT_AVATAR=https://res.cloudinary.com/CHANGE_ME_CLOUD_NAME/image/upload/v1/default-avatar.png

# ----------------------------
# Nginx TLS (montaje de certificados)
# ----------------------------
NGINX_TLS_CERT_PATH=/etc/nginx/certs/tls.crt
NGINX_TLS_KEY_PATH=/etc/nginx/certs/tls.key

